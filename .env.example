ANTHROPIC_API_KEY=your_anthropic_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9

# Telegram second channel (optional — leave blank to run voice-only)
# Bot token from @BotFather; chat id (your numeric Telegram user id) from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Obsidian vault root for the vault tools (optional — leave blank to disable)
VAULT_PATH=

# Morning briefing weather location (Open-Meteo, no API key needed)
BRIEFING_LAT=40.7128
BRIEFING_LON=-74.0060
BRIEFING_PLACE=New York, NY

# Seconds to show the captured frame after a camera tool call (0 disables).
# A webcam has one owner, so a live camera app and JARVIS can't both read it —
# this is how you see what it saw.
CAMERA_PREVIEW_SECONDS=8
